# 운영 배포용 예시. 복사해 .env.production으로 쓰고 SCP_* 값만 채운다(접속 정보는 커밋하지 않는다).
#
# VITE_API_BASE_URL은 Vite가 `--mode production` 빌드에서 읽어 브라우저 번들에 넣는 공개 값이다.
# 운영 빌드는 이 값이 https 주소가 아니면 멈춘다(vite-plugins.ts envCheckPlugin).
VITE_API_BASE_URL=https://api-beauty.dongri.kr

# SCP_*는 deploy.sh가 읽는다. VITE_ 접두사가 없는 값은 브라우저 번들에 들어가지 않는다.
SCP_USER=
SCP_HOST=
SCP_DIR=
SCP_PORT=
